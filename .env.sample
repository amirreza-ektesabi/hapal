# Copy this file to .env at the repository root — used by BOTH the backend
# and the frontend.

# Backend (Django)
DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGIN_REGEXES=

DB_NAME=
DB_USER=
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend (Next.js) — URL of the Django API
NEXT_PUBLIC_HOST=http://localhost:8000
